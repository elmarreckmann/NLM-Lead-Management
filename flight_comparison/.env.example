# Amadeus for Developers API
# Registrierung: https://developers.amadeus.com
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here

# Duffel API
# Registrierung: https://duffel.com
DUFFEL_API_KEY=your_duffel_api_key_here

# SerpApi – Google Flights (kostenlos: 100 Searches/Monat)
# Registrierung: https://serpapi.com/users/sign_up
SERPAPI_KEY=your_serpapi_key_here

# Optional: Proxy-Einstellungen für Scraping (HTTP/SOCKS5)
# HTTP_PROXY=http://user:pass@host:port
# HTTPS_PROXY=https://user:pass@host:port

# Optional: Selenium Chrome-Pfad (leer = automatisch via webdriver-manager)
# CHROME_BINARY_PATH=/usr/bin/google-chrome

# Scraping-Einstellungen
SCRAPING_MIN_DELAY=2
SCRAPING_MAX_DELAY=5
HEADLESS_BROWSER=true
